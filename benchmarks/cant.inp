! B-002 Euler-Bernoulli cantilever, BEAM188 model
! AeroFrame-DT REQ-009. Acceptance in benchmarks/BENCHMARK_LOCK.md
! L = 1 m , b = 0.05 m , h = 0.10 m , E = 70 GPa , tip load P = 1000 N
! Exact tip deflection  1.142857e-3 m
! Exact tip rotation    1.714286e-3 rad
! Exact root stress     12.0 MPa
! Acceptance: 0.5 percent or better on displacement
finish
/clear,nostart
/prep7

et,1,beam188
sectype,1,beam,rect
secdata,0.05,0.10

mp,ex,1,70e9
mp,prxy,1,0.3

k,1,0,0,0
k,2,1,0,0
k,3,0,0,1
l,1,2
latt,1,,1,,3,,1
lesize,1,,,10
lmesh,1

nsel,s,loc,x,0
d,all,all
allsel,all

nsel,s,loc,x,1
f,all,fy,-1000
allsel,all
finish

/solu
antype,static
solve
finish

/post1
set,last
/com,
/com,==== B-002 RESULT : tip node displacement and rotation ====
/com,==== expect UY = -1.142857e-3 m and ROTZ = -1.714286e-3 rad ====
nsel,s,loc,x,1
prnsol,u,comp
prnsol,rot,comp
allsel,all

/com,
/com,==== B-002 RESULT : root bending stress ====
/com,==== expect extreme fibre 12.0 MPa ====
esel,s,elem,,1
etable,smax,smisc,32
etable,smin,smisc,37
pretab,smax,smin
allsel,all
finish

! IF UY COMES OUT AS -4.571e-3 INSTEAD OF -1.143e-3 the rectangular
! section is rotated 90 degrees. Change the secdata line to
!   secdata,0.10,0.05
! and run the file again. Nothing else changes.
