! B-001 constant-strain patch test
! AeroFrame-DT REQ-009. Acceptance in benchmarks/BENCHMARK_LOCK.md
! Exact field: u = 1e-3 x + 2e-4 y , v = -3e-4 x + 5e-4 y
! Exact strains: epsx = 1e-3 , epsy = 5e-4 , gamxy = -1e-4
finish
/clear,nostart
/prep7

et,1,plane182
keyopt,1,1,0
keyopt,1,3,3
r,1,1.0

mp,ex,1,70e9
mp,prxy,1,0.3

rectng,0,1,0,1
esize,0.25
mshkey,0
mshape,0,2d
amesh,all

! distort the interior nodes so this is a real patch test and not a
! regular grid. boundary nodes are left exactly where they are.
nsel,s,loc,x,0.001,0.999
nsel,r,loc,y,0.001,0.999
*get,ni,node,,count
nn=0
*do,i,1,ni
nn=ndnext(nn)
xx=nx(nn)
yy=ny(nn)
nmodif,nn,xx+0.03*sin(9*yy),yy+0.03*cos(7*xx)
*enddo
allsel,all

! prescribe the exact linear field on every boundary node
nsel,s,ext
*get,nb,node,,count
nn=0
*do,i,1,nb
nn=ndnext(nn)
xx=nx(nn)
yy=ny(nn)
d,nn,ux,1e-3*xx+2e-4*yy
d,nn,uy,-3e-4*xx+5e-4*yy
*enddo
allsel,all
finish

/solu
antype,static
solve
finish

/post1
set,last
allsel,all

! largest absolute displacement error anywhere in the patch
*get,nt,node,,count
emax=0
nn=0
*do,i,1,nt
nn=ndnext(nn)
xx=nx(nn)
yy=ny(nn)
uex=1e-3*xx+2e-4*yy
vex=-3e-4*xx+5e-4*yy
*get,ua,node,nn,u,x
*get,va,node,nn,u,y
eu=abs(ua-uex)
ev=abs(va-vex)
*if,eu,gt,emax,then
emax=eu
*endif
*if,ev,gt,emax,then
emax=ev
*endif
*enddo

/com,
/com,==== B-001 RESULT 1 : max absolute displacement error, metres ====
*status,emax
/com,==== acceptance: 1e-10 or smaller ====
/com,

/com,==== B-001 RESULT 2 : element strains, every element ====
/com,==== acceptance: epsx 1e-3 , epsy 5e-4 , gamxy -1e-4 to within 1e-10 ====
etable,epx,epel,x
etable,epy,epel,y
etable,epxy,epel,xy
pretab,epx,epy,epxy

/com,
/com,==== B-001 RESULT 3 : reaction equilibrium on the boundary ====
/com,==== acceptance: FX and FY sums are zero to machine precision ====
nsel,s,ext
fsum
allsel,all
finish
